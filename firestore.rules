rules_version = '2';

// HarmonyTown (Denge Kasabası + Atlas blog)
// Tüm okuma/yazma backend (Cloud Function, firebase-admin) üzerinden yapılır.
// Admin SDK bu kurallardan muaftır; tarayıcı/mobil istemciler doğrudan erişemez.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
