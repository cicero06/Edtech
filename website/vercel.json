{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/denge-kasabasi", "destination": "/denge-kasabasi/index.html" },
    { "source": "/denge-kasabasi/", "destination": "/denge-kasabasi/index.html" },
    { "source": "/denge-kasabasi/oyna", "destination": "/denge-kasabasi/oyna/index.html" },
    { "source": "/denge-kasabasi/oyna/", "destination": "/denge-kasabasi/oyna/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
