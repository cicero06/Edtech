{
  "name": "atlas-learning-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && npm --prefix ./denge-kasabasi-game run build && node scripts/copy-demo.mjs && node scripts/prerender.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "@playwright/test": "1.62.1"
  }
}
