# Atlas backend base URL for the remote pilot flow ("/v2" API).
# Defaults to http://localhost:3000 when unset — only needed for other hosts.
VITE_API_URL=http://localhost:3000

# Adult sign-in on the unified gate (Supabase Auth REST). When unset, the
# e-mail path is hidden and only the dev-handle staff entry remains.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
