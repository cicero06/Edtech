PORT=3000
# Comma-separated extra CORS origins (atlaslearningtech.com and localhost
# are always allowed).
FRONTEND_URL=http://localhost:5173

# --- Firebase (HarmonyTown project) ---------------------------------------
FIREBASE_PROJECT_ID=harmonytown
# Service account JSON for firebase-admin (raw JSON or base64 of it).
# Firebase console → Project settings → Service accounts → Generate key.
# NEVER commit the key file; on Vercel paste it as an encrypted env var.
# FIREBASE_SERVICE_ACCOUNT=
# Local alternative: path to the downloaded key file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/harmonytown-firebase-adminsdk.json

# Local emulator (firebase emulators:start) — when set, no key is needed.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Blog writer allowlist — comma-separated, only these Firebase users may
# create/publish posts via /v2/blog.
BLOG_AUTHOR_EMAILS=writer1@example.com,writer2@example.com

# Optional: Vercel deploy hook URL — hit on publish so published posts get
# prerendered static pages. Project Settings → Git → Deploy Hooks.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
