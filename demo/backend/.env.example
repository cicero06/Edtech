PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/denge_kasabasi?schema=public

# Supabase Auth (adult sign-in, design doc §8.1). Project URL only —
# JWTs are verified via JWKS, no service key lives here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Blog writer allowlist — comma-separated, only these Supabase users may
# create/publish posts via /v2/blog.
BLOG_AUTHOR_EMAILS=writer1@example.com,writer2@example.com

# Optional: Vercel deploy hook URL — hit on publish so published posts get
# prerendered static pages. Project Settings → Git → Deploy Hooks.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
